{
  "name": "investai-desktop",
  "version": "5.2.1",
  "description": "InvestAI - Dashboard de Investimentos Desktop",
  "main": "main.js",
  "scripts": {
    "prepare:renderer": "node scripts/prepare-renderer.js",
    "prestart": "npm run prepare:renderer",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "node scripts/smoke-electron.cjs",
    "prebuild": "npm run check:privacy && npm run prepare:renderer && npm test",
    "build": "electron-builder --publish never",
    "build:minor": "npm run build",
    "build:major": "npm run build",
    "release:patch": "node scripts/bump-version.js patch && npm run build && electron-builder --publish always",
    "release:minor": "node scripts/bump-version.js minor && npm run build && electron-builder --publish always",
    "release:major": "node scripts/bump-version.js major && npm run build && electron-builder --publish always",
    "check:privacy": "node scripts/check-privacy.cjs",
    "check:history": "node scripts/check-privacy.cjs --history",
    "test:responsive": "node scripts/check-responsive.cjs",
    "test:flows": "node scripts/check-app-flows.cjs"
  },
  "author": "Diego",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@google/generative-ai": "^0.21.0",
    "chart.js": "4.5.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "dompurify": "3.4.15",
    "electron-updater": "^6.8.9",
    "gsap": "3.13.0",
    "marked": "15.0.12",
    "node-fetch": "^2.7.0",
    "openai": "^4.78.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.investai.desktop",
    "productName": "VSA",
    "artifactName": "VSA-v${version}-setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Dfirzen",
      "repo": "vsa-financas",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "Icone.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "Icone.png",
      "CHANGELOG.md"
    ]
  }
}
