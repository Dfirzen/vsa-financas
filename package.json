{
  "name": "investai-desktop",
  "version": "1.2.2",
  "description": "InvestAI - Dashboard de Investimentos Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "npx rimraf dist-electron",
    "build": "node scripts/bump-version.js && electron-builder",
    "build:minor": "node scripts/bump-version.js minor && electron-builder",
    "build:major": "node scripts/bump-version.js major && electron-builder"
  },
  "author": "Diego",
  "license": "MIT",
  "dependencies": {
    "yahoo-finance2": "^2.14.0",
    "@google/generative-ai": "^0.21.0",
    "openai": "^4.78.0",
    "@anthropic-ai/sdk": "latest",
    "xlsx": "^0.18.5",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.investai.desktop",
    "productName": "VSA",
    "artifactName": "VSA-v${version}-setup.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "Icone.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "Icone.png",
      "CHANGELOG.md"
    ]
  }
}
